{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main/index.ts",
    "src/main/preload.ts",
    "src/renderer/main.tsx"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "**/*.d.ts"
  ],
  "ignoreDependencies": [
    "vite-plugin-electron",
    "pdfjs-dist"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "off",
    "types": "off"
  }
}
