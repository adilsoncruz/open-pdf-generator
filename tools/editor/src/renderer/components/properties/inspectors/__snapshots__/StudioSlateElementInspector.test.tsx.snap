                  <span
                    class="text-[9px] text-slate-500 font-mono"
                  >
                    RIGHT
                  </span>
                  <input
                    class="bg-transparent text-slate-200 font-mono text-xs focus:outline-none text-right"
                    data-testid="padding-right-input"
                    min="0"
                    type="number"
                    value="0"
                  />
                </div>
                <div
                  class="flex flex-col bg-slate-950/70 border border-slate-800 rounded-lg px-2 py-1 focus-within:border-indigo-500"
                >
                  <span
                    class="text-[9px] text-slate-500 font-mono"
                  >
                    BOTTOM
                  </span>
                  <input
                    class="bg-transparent text-slate-200 font-mono text-xs focus:outline-none text-right"
