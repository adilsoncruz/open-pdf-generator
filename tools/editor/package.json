{
  "name": "pdf-template-editor",
  "version": "1.0.0",
  "description": "Desktop app for creating and editing PDF templates",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "cross-env VITE_PORT=5175 node node_modules/vite/bin/vite.js --port 5175",
    "dev:main": "node node_modules/typescript/bin/tsc -p tsconfig.main.json && cross-env NODE_ENV=development VITE_PORT=5175 node node_modules/electron/cli.js .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "node node_modules/vite/bin/vite.js build",
    "build:main": "node node_modules/typescript/bin/tsc -p tsconfig.main.json",
    "start": "node node_modules/electron/cli.js .",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder -mwl",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "node node_modules/typescript/bin/tsc --noEmit",
    "knip": "knip"
  },
  "keywords": [
    "pdf",
    "template",
    "editor",
    "electron"
  ],
  "author": "Adilson Cruz <adilsoncruz.ac@gmail.com>",
  "homepage": "https://github.com/adilsoncruz/open-pdf-generator",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "ajv": "^8.20.0",
    "clsx": "^2.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-pdf": "^11.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.1",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.2.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@electron/get": "^5.1.0",
    "postcss-selector-parser": "^7.1.6",
    "eslint": "$eslint",
    "undici": "^7.30.1",
    "minimatch": "^11.0.1",
    "fast-uri": "^4.2.3"
  },
  "build": {
    "appId": "com.pdfgenerator.editor",
    "productName": "PDF Template Editor",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/splash.html",
        "to": "splash.html"
      },
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "adilsoncruz",
      "repo": "open-pdf-generator",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
