<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender - output only for errors in production -->
    <!-- target = System.err keeps stdout clean for binary PDF piping (`-o -`) -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Default level: INFO for debug -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
    
    <!-- PDF Generator: DEBUG para ver logs de posicionamento -->
    <logger name="com.pdfgenerator" level="DEBUG" />
</configuration>




