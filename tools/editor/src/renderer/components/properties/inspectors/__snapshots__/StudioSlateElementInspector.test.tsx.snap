            <div
              class="flex items-center gap-1.5 flex-1 min-w-0"
            >
              <input
                class="w-7 h-7 rounded border border-slate-700 bg-slate-950 cursor-pointer p-0.5 shrink-0"
                type="color"
                value="#374151"
              />
              <select
                class="flex-1 bg-slate-950/70 border border-slate-800 rounded-lg px-2 py-1 text-slate-200 text-xs focus:outline-none focus:border-indigo-500 cursor-pointer"
              >
                <option
                  value="solid"
