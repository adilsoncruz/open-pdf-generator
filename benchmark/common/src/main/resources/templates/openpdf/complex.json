{
  "version": "1.0",
  "metadata": {
    "name": "Benchmark Complex Document",
    "description": "Complex layout with watermarks, conditions and transformations"
  },
  "pageSettings": {
    "size": "A4",
    "orientation": "portrait",
    "margins": {
      "top": 36,
      "right": 36,
      "bottom": 36,
      "left": 36
    },
    "watermark": {
      "type": "text",
      "text": "ORIGINAL COPY",
      "color": "#e0e7ff",
      "opacity": 1.0,
      "fontSize": 48,
      "rotation": 0
    }
  },
  "page": [
    {
      "type": "rectangle",
      "id": "top-banner",
      "x": 0,
      "y": 0,
      "width": "100%",
      "height": 5,
      "style": { "fillColor": "#4f46e5", "strokeColor": "#4f46e5" }
    },
    {
      "type": "text",
      "id": "company-title",
      "x": 0,
      "y": 15,
      "dataBinding": "companyName | uppercase",
      "style": { "fontSize": 18, "bold": true, "color": "#1e293b" }
    },
    {
      "type": "text",
      "id": "invoice-title",
      "x": 0,
      "y": 42,
      "value": "Enterprise Service Order & Verification",
      "style": { "fontSize": 12, "color": "#64748b" }
    },
    {
      "type": "text",
      "id": "invoice-number",
      "x": 0,
      "y": 62,
      "dataBinding": "invoiceNumber | prefix:'Order Reference: '",
      "style": { "fontSize": 10, "bold": true, "color": "#0f172a" }
    },
    {
      "type": "barcode",
      "id": "qr-code",
      "barcodeType": "qrcode",
      "dataBinding": "qrCodePayload",
      "x": 448,
      "y": 15,
      "width": 75,
      "height": 75
    },
    {
      "type": "table",
      "id": "items-table",
      "x": 0,
      "y": 95,
      "width": "100%",
      "dataBinding": "items",
      "columns": [
        { "header": "Description", "field": "description", "width": 260 },
        { "header": "Qty", "field": "quantity", "width": 60, "alignment": "center" },
        { "header": "Unit Price", "field": "unitPrice | format:'#,##0.00'", "width": 85, "alignment": "right" },
        { "header": "Total", "field": "total | format:'#,##0.00'", "width": 90, "alignment": "right" }
      ],
      "style": {
        "headerBackground": "#f1f5f9",
        "headerTextColor": "#1e293b",
        "headerFontWeight": "bold",
        "headerFontSize": 9,
        "borderColor": "#cbd5e1",
        "cellBorderType": "row",
        "fontSize": 9
      }
    },
    {
      "type": "barcode",
      "id": "code128-barcode",
      "barcodeType": "code128",
      "dataBinding": "barcodeValue",
      "x": 0,
      "y": 340,
      "width": 160,
      "height": 30
    },
    {
      "type": "text",
      "id": "total-summary",
      "x": 250,
      "y": 345,
      "width": 265,
      "dataBinding": "total | format:'#,##0.00' | prefix:'Final Amount Due: $'",
      "style": { "fontSize": 12, "bold": true, "color": "#4f46e5", "alignment": "right" }
    },
    {
      "type": "conditional",
      "id": "legal-notice-cond",
      "condition": "showLegalNotice == true",
      "elements": [
        {
          "type": "rectangle",
          "id": "legal-box",
          "x": 0,
          "y": 380,
          "width": "100%",
          "height": 50,
          "style": { "fillColor": "#f8fafc", "strokeColor": "#e2e8f0" }
        },
        {
          "type": "text",
          "id": "legal-text",
          "x": 10,
          "y": 395,
          "dataBinding": "notes | prefix:'NOTICE: '",
          "style": { "fontSize": 8, "color": "#64748b" }
        }
      ]
    }

  ]
}
