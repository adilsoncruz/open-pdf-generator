{
  "name": "pdf-template-editor",
  "version": "1.0.0",
  "description": "Desktop app for creating and editing PDF templates",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "node node_modules/vite/bin/vite.js",
    "dev:main": "node node_modules/typescript/bin/tsc -p tsconfig.main.json && cross-env NODE_ENV=development node node_modules/electron/cli.js .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "node node_modules/vite/bin/vite.js build",
    "build:main": "node node_modules/typescript/bin/tsc -p tsconfig.main.json",
    "start": "node node_modules/electron/cli.js .",
    "package": "npm run build && node node_modules/electron-builder/out/cli/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node node_modules/eslint/bin/eslint.js src --ext .ts,.tsx",
    "lint:fix": "node node_modules/eslint/bin/eslint.js src --ext .ts,.tsx --fix",
    "type-check": "node node_modules/typescript/bin/tsc --noEmit",
    "knip": "knip"
  },
  "keywords": [
    "pdf",
    "template",
    "editor",
    "electron"
  ],
  "author": "Adilson Cruz",
  "license": "MIT",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "ajv": "^8.20.0",
    "clsx": "^2.1.0",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-pdf": "^11.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.1",
    "cross-env": "^7.0.3",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jsdom": "^30.1.2",
    "knip": "^5.80.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^0.28.8",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.pdfgenerator.editor",
    "productName": "PDF Template Editor",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/splash.html",
        "to": "splash.html"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "adilsoncruz",
      "repo": "pdf-generator-project",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
